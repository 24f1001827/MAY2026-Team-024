# ==========================
# Flask
# ==========================

FLASK_APP=run.py
FLASK_ENV=1

SECRET_KEY=
JWT_SECRET_KEY=

# ==========================
# PostgreSQL
# ==========================

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=civic_connect

DATABASE_URI=

# ==========================
# Google OAuth
# ==========================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================
# Cloudinary
# ==========================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================
# Celery
# ==========================

CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ==========================
# Flask-Mail
# ==========================

MAIL_SERVER=
MAIL_PORT=
MAIL_USE_TLS=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Gemini AI triage (free tier supported). Leave blank to use the deterministic fallback.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
