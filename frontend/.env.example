# Google Maps — required for the complaints map on the dashboard.
# Create a key in Google Cloud (enable "Maps JavaScript API") and add it here,
# then copy this file to `.env.local`.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID for styled Advanced Markers. Defaults to Google's public
# "DEMO_MAP_ID" when unset.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Base URL of the Flask backend (server-side only). Auth requests are proxied
# through Next route handlers; no NEXT_PUBLIC_ prefix so it never reaches the
# browser. Defaults to http://localhost:5000 when unset.
API_BASE_URL=http://localhost:5000
